{
  "name": "italian-verb-sprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api": "node backend/server.mjs",
    "dev": "vite --host 127.0.0.1",
    "generate:verbs": "PYTHONPATH=./.python-packages python3 scripts/generate_verbs.py",
    "translate:verbs": "PYTHONPATH=./.python-packages python3 scripts/fill_translations.py",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@rollup/wasm-node": "4.60.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.60.4"
    }
  }
}
