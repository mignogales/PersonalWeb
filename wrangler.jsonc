{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainpersonalweb",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/italian/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
