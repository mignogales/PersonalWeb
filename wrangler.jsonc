{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainpersonalweb",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/calories/api/*", "/api/*", "/personal", "/personal/*", "/apps/dashboard", "/apps/dashboard/*"]
  },
  "ratelimits": [
    { "name": "PERSONAL_LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
